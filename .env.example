# -----------------------------------------------------------------------------
# Toolpika — environment variables
#
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit a real key.
# -----------------------------------------------------------------------------

# Site -----------------------------------------------------------------------
# Used for canonical URLs, hreflang, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://toolpika.site

# Supabase (admin dashboard, tool requests, blog, translations) --------------
# Both values are safe to expose to the browser. The service role key below is
# not — it never leaves the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq (translation pipeline only — never used at runtime) -------------------
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
